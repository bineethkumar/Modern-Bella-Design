# Copy this file to .env for local development (never commit .env).
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Your public domain, used for social share images.
VITE_SITE_URL=https://www.example.com

# Supabase > Project > Connect > "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Management login (footer link "Management login").
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe card payments (Developers > API keys, and Webhooks > signing secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Square card payments (optional alternative).
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Force a processor: stripe | square | toast | manual (optional).
# Unset: Stripe if its key is set, else Square, else manual invoicing.
PAYMENT_PROVIDER=
